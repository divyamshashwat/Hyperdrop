# WebRTC infrastructure. Nothing here ever carries photo data.

# STUN lets the two browsers discover how to reach each other.
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302

# direct-only  (default): never hand out a relay. If no direct path exists, the transfer fails honestly.
# allow-relay            : TURN is an explicit, disclosed fallback (UI shows RELAYED).
TRANSFER_POLICY=direct-only

# Only used when TRANSFER_POLICY=allow-relay.
# NEXT_PUBLIC_TURN_URL=turns:turn.example.com:5349
# Preferred: coturn static-auth-secret -> short-lived credentials minted by /api/ice.
# TURN_SHARED_SECRET=change-me-to-a-long-random-string
# Discouraged: static credentials are visible to anyone who opens the page.
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Extra origins allowed to call the signaling API (comma separated). Same-origin is always allowed.
# ALLOWED_ORIGINS=https://origin.example.com

# Developer-only diagnostics overlay (also available with ?diag=1).
# NEXT_PUBLIC_DIAGNOSTICS=1
